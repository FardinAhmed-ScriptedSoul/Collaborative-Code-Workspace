    "test:config": "node --test test/config/env.test.js",
    "test:database": "node --test test/infrastructure/mongoDatabase.test.js test/infrastructure/repositories.test.js",
    "test:tokens": "node --test test/auth/tokens.test.js",
    "test:auth": "node --test test/auth/routes.test.js",
    "test:access": "node --test test/projects/access.test.js",
    "test:projects": "node --test test/projects/routes.test.js",
    "test:invitations": "node --test test/invitations/routes.test.js",
    "test:collab-routes": "node --test test/collaboration/routes.test.js",
    "test:collaboration": "node --test --test-force-exit test/collaboration/rooms.integration.test.js",
    "test:health": "node --test --test-concurrency=1 test/app.test.js",
    "dev": "nodemon src/server.js"
  },
